    "ref-array-di": "git+https://github.com/node-ffi-napi/ref-array-di.git#a48bf0013b5037c16a60e167c6a69b10e90578fc",
    "ref-struct-di": "git+https://github.com/node-ffi-napi/ref-struct-di.git#6d6b932b34f638162a92eb2e3f43e93360435889",
